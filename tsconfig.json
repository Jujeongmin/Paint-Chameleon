{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  // scripts/ and the server's pure rules are typechecked too. They were not,
  // and a rename in game/src left eight check labels printing "undefined"
  // while the check itself still passed — the scripts are the thing that
  // guards this project, so they need guarding themselves.
  "include": ["game/src", "scripts", "server/src/rules.ts"]
}
